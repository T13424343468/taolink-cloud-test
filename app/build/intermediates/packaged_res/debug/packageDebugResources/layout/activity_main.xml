<?xml version="1.0" encoding="utf-8"?>
<!-- 首屏角色选择：品牌头 + 两张大卡（让人帮 = 主色 / 去帮忙 = 描边） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/app_name"
        android:textColor="@color/brand_accent"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/main_tagline"
        android:textColor="@color/brand_text_sub"
        android:textSize="15sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/btn_controlled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_primary"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="20dp"
        android:paddingRight="22dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/role_controlled"
            android:textColor="@color/brand_on_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/role_controlled_aux"
            android:textColor="@color/brand_on_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_secondary"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="20dp"
        android:paddingRight="22dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/role_help"
            android:textColor="@color/brand_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/role_help_aux"
            android:textColor="@color/brand_text_sub"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="@string/main_role_note"
        android:textColor="@color/brand_text_sub"
        android:textSize="12sp" />
</LinearLayout>
