<?xml version="1.0" encoding="utf-8"?>
<!-- 正在连接（定稿原型 v2 s-connecting）：三步进度 + 取消 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/connecting_title"
        android:textColor="@color/brand_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/connecting_peer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/brand_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/connecting_path"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/brand_text_sub"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/step_found"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/gl_ink3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/step_paired"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/gl_ink3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/step_crypto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/gl_ink3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/connecting_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/brand_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_connecting_cancel"
        style="@style/Widget.AppCompat.Button.ButtonBar.AlertDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/connecting_cancel" />
</LinearLayout>
