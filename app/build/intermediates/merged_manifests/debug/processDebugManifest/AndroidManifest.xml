<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建生效：云测双机流水线需要 adb shell（uid 2000）直启内部组件，
  该 API 等级上 shell 无 START_ANY_ACTIVITY，非导出组件会 SecurityException。
  release 包不受影响，仍保持最小攻击面。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tao.tao.link"
    android:versionCode="15"
    android:versionName="0.5.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
 Wi-Fi Direct 配对（0.5.0 拍板：发现与组网换系统 P2P 直连）：
         API 33+ 用 NEARBY_WIFI_DEVICES（neverForLocation）；API 26-32 走定位授权扫 P2P
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <permission
        android:name="com.tao.tao.link.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.tao.tao.link.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.tao.tao.link.TaoLinkApp"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.TaoLink" >
        <activity
            android:name="com.tao.tao.link.ui.PairCodeActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.MasterHomeActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.PairInputActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.DiscoverActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.ConnectingActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.ManageActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.MasterCallActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.ControlledCallActivity"
            android:exported="true" />
        <activity
            android:name="com.tao.tao.link.ui.FileTransferActivity"
            android:exported="true" />

        <service
            android:name="com.tao.tao.link.service.ControlledSessionService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />

        <activity
            android:name="com.tao.tao.link.ui.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.tao.tao.link.accessibility.TaoLinkAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.tao.tao.link.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>