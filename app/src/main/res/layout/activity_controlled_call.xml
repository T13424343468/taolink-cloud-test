<?xml version="1.0" encoding="utf-8"?>
<!-- 被控端通话页（被控零操作）：远端大窗全屏，本地小窗右上角悬浮，无操作按钮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gl_canvas"
    android:keepScreenOn="true">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/call_remote_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/call_local_view"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:text="@string/call_status_connected"
        android:textColor="@color/gl_on_canvas"
        android:textSize="13sp" />
</FrameLayout>
