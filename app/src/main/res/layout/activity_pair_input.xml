<?xml version="1.0" encoding="utf-8"?>
<!-- 输配对码（定稿原型 v2 s-pair-input）：6 位输入 + 连接 + 提示语逐字 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pair_input_title"
        android:textColor="@color/brand_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pair_input_aux"
        android:textColor="@color/brand_text_sub"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/pair_code_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@color/brand_card_soft"
        android:gravity="center"
        android:hint="@string/pair_input_code_hint"
        android:inputType="number"
        android:letterSpacing="0.3"
        android:maxLength="6"
        android:padding="16dp"
        android:textColor="@color/brand_text"
        android:textSize="28sp" />

    <Button
        android:id="@+id/btn_connect_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pair_input_connect" />

    <TextView
        android:id="@+id/pair_input_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/brand_text_sub"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pair_input_p2p_searching"
        android:textColor="@color/gl_ink3"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pair_input_aux2"
        android:textColor="@color/gl_ink3"
        android:textSize="12sp" />
</LinearLayout>
