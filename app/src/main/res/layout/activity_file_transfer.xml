<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/brand_bg">

    <TextView
        android:id="@+id/file_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/file_title"
        android:textColor="@color/brand_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/file_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/file_status_idle"
        android:textColor="@color/gl_ink2" />

    <Button
        android:id="@+id/btn_file_pick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/file_pick" />

    <Button
        android:id="@+id/btn_file_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/file_back" />
</LinearLayout>
