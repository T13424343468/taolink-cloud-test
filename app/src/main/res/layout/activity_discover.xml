<?xml version="1.0" encoding="utf-8"?>
<!-- 附近设备（定稿原型 v2 s-discover / s-discover-empty） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/discover_title"
        android:textColor="@color/brand_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/discover_scanning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/discover_scanning"
        android:textColor="@color/brand_text_sub"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/discover_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp" />

    <TextView
        android:id="@+id/discover_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/discover_none_hint"
        android:textColor="@color/gl_ink3"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_back_input"
        style="@style/Widget.AppCompat.Button.ButtonBar.AlertDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/discover_back_input" />
</LinearLayout>
