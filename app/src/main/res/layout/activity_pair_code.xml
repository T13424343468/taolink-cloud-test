<?xml version="1.0" encoding="utf-8"?>
<!-- 被控端配对码页：状态行 + 大字配对码深色药丸 + 亮屏提醒 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:keepScreenOn="true"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/role_controlled"
        android:textColor="@color/brand_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pair_code_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/pair_code_hint"
        android:textColor="@color/brand_text_sub"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_code_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="30dp"
        android:paddingRight="24dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/pair_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:textColor="@color/brand_on_accent"
            android:textSize="64sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/pair_code_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/brand_text_sub"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/pair_keep_screen"
        android:textColor="@color/brand_text_sub"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/pair_code_serve"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/brand_text_sub"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/pair_code_battery_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/battery_banner"
        android:textColor="@color/brand_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_battery_allow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/btn_battery_allow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pair_code_hotspot_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/pair_code_hotspot_title"
        android:textColor="@color/brand_text_sub"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_hotspot_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/btn_hotspot_open" />
</LinearLayout>
